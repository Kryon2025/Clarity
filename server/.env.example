# ===== 深清商店服务端配置 =====
# 复制为 .env 后按需修改；环境变量优先于 .env。
# 生产环境务必换掉 SECRET_KEY / ADMIN_PASSWORD。

# JWT 签名密钥（必改）：建议 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 初始管理员（首次启动时若该邮箱不存在则自动创建；已存在不会改密码）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# SQLite 数据库路径；相对路径相对于 server/ 目录
DATABASE_PATH=store.db

# 登录 token 有效期（秒），默认 7 天
TOKEN_TTL_SECONDS=604800

# CORS 允许来源，逗号分隔；* 表示全部（桌面端 / 浏览器）
CORS_ORIGINS=*

# 对外基础地址（可选）：反代/CDN 后若 request.base_url 不对，用它固定 catalog 里的绝对下载地址
# PUBLIC_BASE_URL=https://store.example.com

# catalog.json 顶层 version 字段（默认 0.19.0，与桌面端版本保持一致即可）
# APP_VERSION=0.19.0

# 静态前端目录（默认 server/static，不建议改）
# STATIC_DIR=
